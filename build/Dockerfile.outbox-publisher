# build/Dockerfile.outbox-publisher
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/outbox-publisher ./cmd/outbox-publisher

FROM alpine:3.20
COPY --from=build /out/outbox-publisher /usr/local/bin/outbox-publisher
USER nobody
ENTRYPOINT ["/usr/local/bin/outbox-publisher"]
