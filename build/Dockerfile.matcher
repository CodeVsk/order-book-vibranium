# build/Dockerfile.matcher
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/matcher ./cmd/matcher

FROM alpine:3.20
COPY --from=build /out/matcher /usr/local/bin/matcher
USER nobody
ENTRYPOINT ["/usr/local/bin/matcher"]
